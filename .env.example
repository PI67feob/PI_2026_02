# Variáveis de ambiente do Caderno de Campo (AgroGestor).
#
# Como usar:
#   1. Copie este arquivo para `.env` (o `.env` está no .gitignore e NUNCA vai
#      para o repositório; cada pessoa mantém o seu).
#   2. Preencha cada variável com os valores do SEU computador.
#   3. Exporte as variáveis no terminal antes de rodar o programa. O código lê
#      o ambiente do sistema (`ConfiguracaoBanco.doAmbiente()`); ele não abre o
#      arquivo `.env` sozinho.
#
# Este arquivo guarda só os NOMES das variáveis. Os exemplos ficam nos
# comentários e nunca incluem senha. Não escreva senha aqui.
# Mais detalhes em banco/RESERVADO_PARA_SQL.md.

# Servidor do MySQL. Exemplo: 127.0.0.1. No banco da AWS é o endereço do RDS
# (peça ao Diogo).
DB_HOST=

# Porta do MySQL. Exemplo: 3306
DB_PORT=

# Nome do schema. No banco da equipe: caderno_fazenda (a PI-012 sugeria
# agrogestor; a escolha do padrão está em aberto, veja o README).
DB_NAME=

# Usuário da aplicação, NUNCA o root. Exemplo: agrogestor_app (PI-014)
DB_USER=

# Senha do usuário acima. A senha real fica só no seu `.env` local.
DB_PASSWORD=

# Ambiente: desenvolvimento | producao
APP_ENV=
